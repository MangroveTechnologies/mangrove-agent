{
  "name": "mangrove-agent",
  "version": "0.2.0",
  "description": "Local client for Mangrove strategy research, backtesting, paper trading, and supported execution workflows. Mangrove services enforce deterministic risk checks based on live market and account conditions; custody depends on the selected connection and wallet mode.",
  "author": {
    "name": "Mangrove Technologies",
    "url": "https://github.com/MangroveTechnologies"
  },
  "homepage": "https://mangrove.ai/agents/",
  "repository": "https://github.com/MangroveTechnologies/mangrove-agent",
  "license": "MIT",
  "privacyPolicyUrl": "https://mangrove.ai/privacy-policy/",
  "termsOfServiceUrl": "https://mangrove.ai/terms-of-service/",
  "keywords": [
    "trading",
    "backtesting",
    "defi",
    "kraken",
    "robinhood",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-code-plugin",
    "codex",
    "paper-trading",
    "x402",
    "ai-trading-agent"
  ],
  "userConfig": {
    "mangrove_api_key": {
      "type": "string",
      "title": "MangroveAI API key",
      "description": "Your dev_ or prod_ key from https://mangrovedeveloper.ai. Stored by Claude Code; never paste it into chat.",
      "required": true,
      "sensitive": true
    }
  },
  "skills": [
    "./.claude/skills/trading-bot",
    "./.claude/skills/setup-kraken",
    "./.claude/skills/connect-kraken",
    "./.claude/skills/setup-robinhood"
  ],
  "hooks": "./.claude-plugin/hooks.json",
  "mcpServers": {
    "mangrove-agent": {
      "type": "http",
      "url": "http://127.0.0.1:9080/mcp/",
      "headers": {
        "X-API-Key": "${user_config.mangrove_api_key}"
      }
    }
  }
}
