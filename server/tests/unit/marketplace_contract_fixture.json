{
  "marketplace_list_offers": {
    "name": "marketplace_list_offers",
    "description": "Read my offers and their payment/delivery status from Markets.\n\nPrivate, free history for the proven participant wallet; role is buyer,\nseller or all. Use the caller's wallet through prepare/submit to sign a\nread authorization, which moves no funds and creates no offer. Wallet-only\naccess is supported; API-key callers also need execution:read.\nFollow next_cursor for another page.\nLocal approval records are not evidence that a server offer exists.\n",
    "inputSchema": {
      "properties": {
        "participant_address": {
          "title": "Participant Address",
          "type": "string"
        },
        "chain": {
          "default": "base",
          "title": "Chain",
          "type": "string"
        },
        "role": {
          "default": "all",
          "title": "Role",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "ownership_proof": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Proof"
        }
      },
      "required": [
        "participant_address"
      ],
      "title": "list_offersArguments",
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "list_offersOutput",
      "type": "object"
    },
    "_meta": {
      "mangrove/marketplace": {
        "version": 1,
        "mode": "ownership",
        "protocol": "ownership-v1",
        "actor_field": "participant_address",
        "wallet_defaults": {
          "base": {
            "chain": "base"
          },
          "xrpl": {
            "chain": "xrpl"
          }
        }
      }
    }
  },
  "marketplace_get_offer": {
    "name": "marketplace_get_offer",
    "description": "Check the current server status of my existing offer without paying again.\n\nFree private read for its buyer or seller with a participant-wallet read\nsignature via prepare/submit. Wallet-only access is supported; API-key\ncallers also need execution:read.\nAwaiting payment is not a purchase; payment_unconfirmed must be reconciled;\ncompleted means confirmed payment and delivery. Never inspect local files\nto infer remote offer status. This read does not retry or settle payment.\n",
    "inputSchema": {
      "properties": {
        "offer_id": {
          "title": "Offer Id",
          "type": "string"
        },
        "participant_address": {
          "title": "Participant Address",
          "type": "string"
        },
        "chain": {
          "default": "base",
          "title": "Chain",
          "type": "string"
        },
        "ownership_proof": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Proof"
        }
      },
      "required": [
        "offer_id",
        "participant_address"
      ],
      "title": "get_offerArguments",
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "get_offerOutput",
      "type": "object"
    },
    "_meta": {
      "mangrove/marketplace": {
        "version": 1,
        "mode": "ownership",
        "protocol": "ownership-v1",
        "actor_field": "participant_address",
        "wallet_defaults": {
          "base": {
            "chain": "base"
          },
          "xrpl": {
            "chain": "xrpl"
          }
        }
      }
    }
  },
  "marketplace_create_listing": {
