  "marketplace_make_offer": {
    "name": "marketplace_make_offer",
    "description": "Make an offer on a marketplace listing.\n\nRoutes to XRP escrow, RLUSD x402, or Base/USDC x402 based on chain/currency.\nFor a new offer, read the listing and pass its revision as expected_revision\nto bind approval to the reviewed terms. Existing payment retries retain\ntheir original arguments and offer ID.\n\n**XRP escrow path** (chain='xrpl', currency='XRP'):\n  1. Call with no payment -- returns offer_id and escrow creation params.\n  2. Call escrow_create with the returned params to get an unsigned tx.\n  3. Sign and broadcast the tx via wallet_xrpl_broadcast.\n  4. Call marketplace_accept_offer with the offer_id and escrow_sequence.\n\n**RLUSD x402 path** (chain='xrpl', currency='RLUSD'):\n  1. Call with no payment -- returns offer_id and x402 payment requirements.\n  2. Sign the RLUSD payment using the x402 SDK.\n  3. Call again with the same offer_id and the base64-encoded payment.\n\n**Base/USDC x402 path** (chain='base', currency='USDC'):\n  1. Call with no payment -- returns offer_id and x402 payment requirements.\n  2. Sign the USDC payment on Base using the x402 EVM SDK.\n  3. Call again with the same offer_id and the base64-encoded payment.\n\nArgs:\n    listing_id: ID of the listing to make an offer on.\n    buyer_address: Buyer's address (XRPL classic r... or EVM 0x...).\n    chain: Payment chain -- 'xrpl' or 'base'.\n    currency: Payment currency -- 'XRP', 'RLUSD', or 'USDC'.\n    payment: Base64-encoded x402 payment (RLUSD/USDC path second call).\n    offer_id: Offer ID from the first call (RLUSD/USDC path second call).\n",
    "inputSchema": {
      "properties": {
        "listing_id": {
          "title": "Listing Id",
          "type": "string"
        },
        "buyer_address": {
          "title": "Buyer Address",
          "type": "string"
        },
        "chain": {
          "default": "xrpl",
          "title": "Chain",
          "type": "string"
        },
        "currency": {
          "default": "XRP",
          "title": "Currency",
          "type": "string"
        },
        "payment": {
          "default": "",
          "title": "Payment",
          "type": "string"
        },
        "offer_id": {
          "default": "",
          "title": "Offer Id",
          "type": "string"
        },
        "expected_revision": {
          "default": "",
          "title": "Expected Revision",
          "type": "string"
        },
        "ownership_proof": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Proof"
        }
      },
      "required": [
        "listing_id",
        "buyer_address"
      ],
      "title": "make_offerArguments",
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "make_offerOutput",
      "type": "object"
    },
    "_meta": {
      "mangrove/marketplace": {
        "version": 1,
        "mode": "ownership",
        "protocol": "ownership-v1",
        "actor_field": "buyer_address",
        "wallet_defaults": {
          "base": {
            "chain": "base",
            "currency": "USDC"
          },
          "xrpl": {
            "chain": "xrpl",
            "currency": "XRP"
          }
        },
        "prepare_constraints": {
          "payment": "",
          "offer_id": ""
        }
      }
    }
  },
