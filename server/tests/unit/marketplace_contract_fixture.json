  "marketplace_accept_offer": {
    "name": "marketplace_accept_offer",
    "description": "Seller accepts an offer on their listing.\n\n**XRP escrow path**: escrow_sequence is required. Provide the Sequence\nfield from the on-chain EscrowCreate transaction the buyer broadcast.\nTransitions the listing to 'escrowed' status.\n\n**RLUSD path**: escrow_sequence is not required. The offer should already\nbe in 'accepted' status after the buyer completed x402 payment.\n\nArgs:\n    offer_id: ID of the offer to accept.\n    seller_address: Seller's XRPL address (must match the listing seller).\n    escrow_sequence: Sequence from EscrowCreate tx (XRP path only).\n",
    "inputSchema": {
      "properties": {
        "offer_id": {
          "title": "Offer Id",
          "type": "string"
        },
        "seller_address": {
          "title": "Seller Address",
          "type": "string"
        },
        "escrow_sequence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Escrow Sequence"
        },
        "ownership_proof": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Proof"
        }
      },
      "required": [
        "offer_id",
        "seller_address"
      ],
      "title": "accept_offerArguments",
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "accept_offerOutput",
      "type": "object"
    },
    "_meta": {
      "mangrove/marketplace": {
        "version": 1,
        "mode": "ownership",
        "protocol": "ownership-v1",
        "actor_field": "seller_address"
      }
    }
  },
  "marketplace_confirm_delivery": {
