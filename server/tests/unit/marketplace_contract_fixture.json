  "marketplace_update_listing": {
    "name": "marketplace_update_listing",
    "description": "Update an active listing with its seller's wallet authorization.\n\nRead the listing first and pass its revision as expected_revision. Supply\nonly changed title, description, tags or price_amount; omitted/null fields\nstay unchanged. Price uses the listing's existing currency and chain.\nSeller, category, delivery terms and identity cannot be changed. Reserved,\nexpired and sold listings cannot be edited. A stale revision requires a\nfresh review and approval.\n\nUse the caller's selected wallet for preparation, even when it differs\nfrom the listing's seller. Markets checks authorization before issuing\na signing challenge. Do not refuse locally based on an address comparison\nor substitute the listing owner's address for the caller's wallet.\nIf the client offers a preparation/approval flow, request preparation\nfirst; signing and submission still require explicit user approval.\nThe server's refusal message is the complete user-facing explanation.\n\nArgs:\n    seller_address: Caller's selected wallet address to authorize. Markets\n        verifies that it controls the listing; do not copy the listing's\n        owner address when the caller selected a different wallet.\n",
    "inputSchema": {
      "properties": {
        "listing_id": {
          "title": "Listing Id",
          "type": "string"
        },
        "seller_address": {
          "title": "Seller Address",
          "type": "string"
        },
        "expected_revision": {
          "title": "Expected Revision",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "price_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Amount"
        },
        "ownership_proof": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Proof"
        }
      },
      "required": [
        "listing_id",
        "seller_address",
        "expected_revision"
      ],
      "title": "update_listingArguments",
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "update_listingOutput",
      "type": "object"
    },
    "_meta": {
      "mangrove/marketplace": {
        "version": 1,
        "mode": "ownership",
        "protocol": "ownership-v1",
        "actor_field": "seller_address"
      }
    }
  },
  "marketplace_search": {
    "name": "marketplace_search",
    "description": "Search listings using API-key quota or $0.01 USDC wallet payment.\n\nprice.chain identifies the blockchain family; price.network identifies\nthe settlement network. Never infer mainnet from chain=\"base\". A null\nnetwork is unconfirmed and cannot be used for a purchase.\nMake a fresh call for each new marketplace search: availability and prices\ncan change. Reuse conversation results only when the user explicitly asks\nabout those earlier results. Recovery retries reuse the original operation\nID and unchanged arguments; a new search is a new operation.\nUse the x402 MCP payment and recovery metadata returned by the server.\nThe payment argument remains available for legacy clients.\n",
    "inputSchema": {
      "properties": {
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "category": {
          "anyOf": [
            {
